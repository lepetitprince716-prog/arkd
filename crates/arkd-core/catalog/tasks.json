  {
    "task_type": "Roguelike",
    "summary": "Run Integrated Strategies until a stop condition is met.",
    "notes": "Several fields are theme-specific: foldartal options apply to Sami, collapsal paradigms to Mizuki, blackflow_* to BlackFlow. Passing one to the wrong theme is ignored rather than rejected.",
    "schema": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true,
          "description": "Whether to run this task. A disabled task stays in the queue and is skipped."
        },
        "theme": {
          "type": "string",
          "enum": [
            "Phantom",
            "Mizuki",
            "Sami",
            "Sarkaz",
            "JieGarden",
            "BlackFlow"
          ],
          "default": "Phantom",
          "description": "Which IS season to play."
        },
        "mode": {
          "type": "integer",
          "default": 0,
          "description": "Run strategy: 0 farm score, 1 farm originium ingots (exit after investing), 4 collectible mode, 5 clear the theme, 6 collapsal-paradigm farming. See MAA's IS schema for the full list, which is theme-dependent."
        },
        "squad": {
          "type": "string",
          "description": "Squad name, in the client's language."
        },
        "roles": {
          "type": "string",
          "description": "Starting role preference."
        },
        "core_char": {
          "type": "string",
          "description": "Operator name to start with."
        },
        "use_support": {
          "type": "boolean",
          "default": false
        },
        "use_nonfriend_support": {
          "type": "boolean",
          "default": false
        },
        "starts_count": {
          "type": "integer",
          "minimum": 0,
          "default": 2147483647,
          "description": "How many runs to start."
        },
        "difficulty": {
          "type": "integer",
          "minimum": -1,
          "default": -1,
          "description": "Difficulty to select. -1 leaves it unchanged."
        },
        "stop_at_final_boss": {
          "type": "boolean",
          "default": false
        },
        "stop_at_max_level": {
          "type": "boolean",
          "default": false
        },
        "investment_enabled": {
          "type": "boolean",
          "default": true
        },
        "investments_count": {
          "type": "integer",
          "minimum": 0,
          "default": 2147483647
        },
        "stop_when_investment_full": {
          "type": "boolean",
          "default": false
        },
        "investment_with_more_score": {
          "type": "boolean",
          "default": false
        },
        "start_with_elite_two": {
          "type": "boolean",
          "default": false
        },
        "only_start_with_elite_two": {
          "type": "boolean",
          "default": false
        },
        "refresh_trader_with_dice": {
          "type": "boolean",
          "default": false
        },
        "first_floor_foldartal": {
          "type": "string"
        },
        "start_foldartal_list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collectible_mode_start_list": {
          "type": "object"
        },
        "use_foldartal": {
          "type": "boolean"
        },
        "check_collapsal_paradigms": {
          "type": "boolean"
        },
        "double_check_collapsal_paradigms": {
          "type": "boolean",
          "default": true
        },
        "expected_collapsal_paradigms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monthly_squad_auto_iterate": {
          "type": "boolean"
        },
        "monthly_squad_check_comms": {
          "type": "boolean"
        },
        "deep_exploration_auto_iterate": {
          "type": "boolean"
        },
        "collectible_mode_shopping": {
          "type": "boolean",
          "default": false
        },
        "collectible_mode_squad": {
          "type": "string"
        },
        "start_with_seed": {
          "type": "string"
        },
        "blackflow_strategy": {
          "type": "string"
        },
        "blackflow_cultivation_target": {
          "type": "string",
          "default": "swaddled_cat"
        },
        "find_playTime_target": {
          "type": "integer"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "example": {
      "enable": true,
      "theme": "Sarkaz",
      "mode": 0,
      "starts_count": 3
    }
  },
  {
    "task_type": "Copilot",
    "summary": "Run a recorded battle plan (copilot job) on its stage.",
    "notes": "Exactly one of 'filename' or 'copilot_list' must be set. When ARKAUTO_JOB_DIR is configured, paths are resolved inside it and paths escaping it are rejected.",
    "schema": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true,
          "description": "Whether to run this task. A disabled task stays in the queue and is skipped."
        },
        "filename": {
          "type": "string",
          "description": "Path to a copilot job JSON. Mutually exclusive with copilot_list."
        },
        "copilot_list": {
          "type": "array",
          "description": "A list of jobs to run in order. Mutually exclusive with filename.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "filename": {
                    "type": "string"
                  },
                  "nav_name_override": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "is_raid": {
                    "type": "boolean"
                  },
                  "formation": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        },
        "formation": {
          "type": "boolean",
          "default": false,
          "description": "Let MAA assemble the squad from the job's operator list."
        },
        "nav_name_override": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_raid": {
          "type": "boolean",
          "default": false
        },
        "loop_times": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "add_trust": {
          "type": "boolean",
          "default": false
        },
        "select_formation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "default": 0
        },
        "use_sanity_potion": {
          "type": "boolean",
          "default": false
        },
        "need_navigate": {
          "type": "boolean",
          "default": true
        },
        "navigate_name": {
          "type": "string"
        },
        "ignore_requirements": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "example": {
      "enable": true,
      "filename": "GA-EX8-raid.json",
      "formation": false
    }
  },
  {
    "task_type": "SSSCopilot",
