[
  {
    "task_type": "StartUp",
    "summary": "Open the game, wait for the main screen, optionally switch account.",
    "notes": "Put this first in the queue. Account switching only reaches accounts already logged in on the device.",
    "schema": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true,
          "description": "Whether to run this task. A disabled task stays in the queue and is skipped."
        },
        "client_type": {
          "type": "string",
          "enum": [
            "Official",
            "Bilibili",
            "txwy",
            "YoStarEN",
            "YoStarJP",
            "YoStarKR"
          ],
          "description": "Game client to start."
        },
        "start_game_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Launch the client if it is not already running."
        },
        "account_name": {
          "type": "string",
          "description": "Switch to an already logged-in account. Matched as a substring of the login name, which must be unique among logged-in accounts (e.g. '4567' for '123****4567')."
        }
      },
      "required": [
        "client_type"
      ],
      "additionalProperties": false
    },
    "example": {
      "enable": true,
      "client_type": "Official",
      "start_game_enabled": true
    }
  },
  {
    "task_type": "CloseDown",
    "summary": "Close the game client.",
    "notes": "Usually queued last, after all farming tasks.",
    "schema": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true,
          "description": "Whether to run this task. A disabled task stays in the queue and is skipped."
        },
        "client_type": {
          "type": "string",
          "enum": [
            "Official",
            "Bilibili",
            "txwy",
            "YoStarEN",
            "YoStarJP",
            "YoStarKR"
          ],
          "description": "Client to close. Nothing happens if omitted."
        }
      },
      "required": [
        "client_type"
      ],
      "additionalProperties": false
    },
    "example": {
      "enable": true,
      "client_type": "Official"
    }
  },
  {
    "task_type": "Fight",
    "summary": "Farm a stage, spending sanity potions and originite as configured.",
    "notes": "'stage' cannot be changed while the task runs. Setting 'stone' spends originite prime, which is premium currency -- leave it at 0 unless the user asked for it.",
    "schema": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true,
          "description": "Whether to run this task. A disabled task stays in the queue and is skipped."
        },
        "stage": {
          "type": "string",
          "description": "Stage code. Empty string means the current/last stage. Main-line stages accept a '-NORMAL'/'-HARD' suffix; resource stages must name level 5 or 6 explicitly (e.g. 'CE-6', 'LS-6', 'CA-5'); annihilation uses 'Annihilation' or e.g. 'Chernobog@Annihilation'."
        },
        "medicine": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Maximum sanity potions to drink."
        },
        "medicine_expire_days": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Only drink potions expiring within this many days. 0 disables."
        },
        "stone": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Maximum originite prime to crack. Spends premium currency."
        },
        "times": {
          "type": "integer",
          "minimum": 0,
          "default": 2147483647,
          "description": "Number of runs. Defaults to 'until sanity runs out'."
        },
        "series": {
          "type": "integer",
          "minimum": -1,
          "maximum": 10,
          "default": 1,
          "description": "Consecutive-run count (multi-battle). -1 leaves the in-game setting alone."
        },
        "drops": {
          "type": "object",
          "description": "Stop when a drop target is met: {item_id_or_name: count}.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "report_to_penguin": {
          "type": "boolean",
          "default": false,
          "description": "Upload drop statistics to Penguin Stats."
        },
        "penguin_id": {
          "type": "string",
          "description": "Penguin Stats user id."
        },
        "report_to_yituliu": {
          "type": "boolean",
          "default": false,
          "description": "Upload drop statistics to Yituliu."
        },
        "yituliu_id": {
          "type": "string",
          "description": "Yituliu user id."
        },
        "server": {
          "type": "string",
          "enum": [
            "CN",
            "US",
            "JP",
            "KR"
          ],
          "default": "CN",
          "description": "Server the drop report is attributed to."
        },
        "client_type": {
          "type": "string",
          "enum": [
            "Official",
            "Bilibili",
            "txwy",
            "YoStarEN",
            "YoStarJP",
            "YoStarKR"
          ],
          "description": "Client to restart if the game drops out mid-run."
        },
        "DrGrandet": {
          "type": "boolean",
          "default": false,
          "description": "Delay originite use until the last second of the sanity tick."
        },
        "expiring_medicine": {
          "type": "integer",
          "minimum": 0,
          "deprecated": true,
          "description": "Deprecated since MAA v6.8.0; use medicine_expire_days."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "example": {
      "enable": true,
      "stage": "1-7",
      "medicine": 0,
      "times": 5
    }
  },
  {
    "task_type": "Recruit",
    "summary": "Run public recruitment: refresh tags, pick tags, confirm, expedite.",
    "notes": "'select' is what gets ticked, 'confirm' is what gets committed. Listing 5 or 6 in 'confirm' will spend a slot on a senior/top operator tag instead of leaving it for manual handling.",
    "schema": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true,
          "description": "Whether to run this task. A disabled task stays in the queue and is skipped."
        },
        "refresh": {
          "type": "boolean",
          "default": false,
          "description": "Refresh tags when no 3-star tag combination is present."
        },
        "select": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "minItems": 1,
          "description": "Star levels whose tags should be selected, e.g. [4, 5]."
        },
        "confirm": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "minItems": 1,
          "description": "Star levels the recruitment is actually confirmed for."
        },
        "first_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags preferred on a 3-star result."
        },
        "extra_tags_mode": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ],
          "default": 0,
          "description": "0 default, 1 always pick 3 tags, 2 pick 3 tags for high-rarity combos."
        },
        "times": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "How many recruitment slots to run."
        },
        "set_time": {
          "type": "boolean",
          "default": true,
          "description": "Set the recruitment duration."
        },
        "expedite": {
          "type": "boolean",
          "default": false,
          "description": "Use expedited plans."
        },
        "expedite_times": {
          "type": "integer",
          "minimum": 0,
          "description": "How many expedited plans to use."
        },
        "skip_robot": {
          "type": "boolean",
          "default": true,
          "description": "Skip recruitments whose tags guarantee a robot."
        },
        "preserve_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags never auto-selected, kept for manual review."
        },
        "recruitment_time": {
          "type": "object",
          "description": "Per star level recruitment minutes, e.g. {\"3\": 540}.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "report_to_penguin": {
          "type": "boolean",
          "default": false
        },
        "penguin_id": {
          "type": "string"
        },
        "report_to_yituliu": {
          "type": "boolean",
          "default": false
        },
        "yituliu_id": {
          "type": "string"
        },
        "server": {
          "type": "string",
          "enum": [
            "CN",
            "US",
            "JP",
            "KR"
          ],
          "default": "CN"
        }
      },
      "required": [
        "select",
        "confirm"
      ],
      "additionalProperties": false
    },
    "example": {
      "enable": true,
      "select": [
        4
      ],
      "confirm": [
        3,
        4
      ],
      "times": 4,
      "skip_robot": true
    }
  },
  {
    "task_type": "Infrast",
    "summary": "Rotate base facilities, use drones, collect clues, manage dorms.",
    "notes": "mode 10000 additionally requires 'filename' and 'plan_index'; see MAA's base scheduling schema for the plan file format.",
    "schema": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true,
          "description": "Whether to run this task. A disabled task stays in the queue and is skipped."
        },
        "mode": {
          "type": "integer",
          "enum": [
            0,
            10000,
            20000
          ],
          "default": 0,
          "description": "0 default (solver picks shifts), 10000 custom (reads a plan file), 20000 rotation (keeps shifts, does drone/clue chores)."
        },
        "facility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Mfg",
              "Trade",
              "Power",
              "Control",
              "Reception",
              "Office",
              "Dorm",
              "Processing",
              "Training"
            ]
          },
          "minItems": 1,
          "description": "Facilities to handle. In mode 0 this is an unordered set; in mode 10000/20000 the array order is the processing order."
        },
        "drones": {
          "type": "string",
          "enum": [
            "_NotUse",
            "Money",
            "SyntheticJade",
            "CombatRecord",
            "PureGold",
            "OriginStone",
            "Chip"
          ],
          "default": "_NotUse",
          "description": "What to spend drones on. Ignored in mode 10000."
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.0,
          "default": 0.3,
          "description": "Morale threshold below which an operator is swapped out."
        },
        "replenish": {
          "type": "boolean",
          "default": false,
          "description": "Replenish originium shards in the trading post."
        },
        "dorm_notstationed_enabled": {
          "type": "boolean",
          "default": false
        },
        "dorm_trust_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Fill dorms with operators below max trust."
        },
        "fiammetta_targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Operators Fiammetta may target."
        },
        "fiammetta_recovery_enabled": {
          "type": "boolean",
          "default": false
        },
        "use_pinus_sylvestris": {
          "type": "boolean",
          "default": false
        },
        "use_perception_information": {
          "type": "boolean",
          "default": false
        },
        "use_worldly_plight": {
          "type": "boolean",
          "default": false
        },
        "use_abyssal_hunter": {
          "type": "boolean",
          "default": false
        },
        "reception_message_board": {
          "type": "boolean",
          "default": true
        },
        "reception_clue_exchange": {
          "type": "boolean",
          "default": true
        },
        "reception_send_clue": {
          "type": "boolean",
          "default": true
        },
        "filename": {
          "type": "string",
          "description": "Custom plan file. Required when mode is 10000."
        },
        "plan_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Which plan inside the file to use. Required when mode is 10000."
        },
        "continue_training": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "facility"
      ],
      "additionalProperties": false
    },
    "example": {
      "enable": true,
      "mode": 0,
      "facility": [
        "Mfg",
        "Trade",
        "Power",
        "Control",
        "Reception",
        "Office",
        "Dorm"
      ],
      "drones": "Money",
      "threshold": 0.3
    }
  },
  {
    "task_type": "Mall",
    "summary": "Visit friends' bases and spend credit in the store.",
    "notes": "Item names are matched against the store as displayed by the client's own language.",
    "schema": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": true,
          "description": "Whether to run this task. A disabled task stays in the queue and is skipped."
        },
        "visit_friends": {
          "type": "boolean",
          "default": true
        },
        "shopping": {
          "type": "boolean",
          "default": true
        },
        "buy_first": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Items bought first, in order of preference."
        },
        "blacklist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Items never bought."
        },
        "force_shopping_if_credit_full": {
          "type": "boolean",
          "default": false
        },
        "only_buy_discount": {
          "type": "boolean",
          "default": false
        },
        "reserve_max_credit": {
          "type": "boolean",
          "default": false,
          "description": "Stop buying once credit would drop below 300."
        },
        "credit_fight": {
          "type": "boolean",
          "default": false,
          "description": "Run the daily credit-earning battle first."
        },
        "formation_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "default": 0,
          "description": "Squad slot used for the credit battle. 0 keeps the current squad."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "example": {
      "enable": true,
      "shopping": true,
      "buy_first": [
        "招聘许可",
        "龙门币"
      ],
      "blacklist": [
        "家具",
        "碳"
      ]
    }
  },
