  {
    "task_type": "ParadoxCopilot",
    "summary": "Run paradox simulation battles from a job file or list.",
    "notes": "Exactly one of 'filename' or 'list' must be set.",
    "schema": {
      "type": "object",
      "properties": {
        "enable": {
